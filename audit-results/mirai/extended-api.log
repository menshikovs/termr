$result
function () 
{
    switch(private$rv_status(), running = req(FALSE, cancelOutput = "progress"), 
        success = if (private$rv_value()$visible) {
            private$rv_value()$value
        } else {
            invisible(private$rv_value()$value)
        }, error = stop(private$rv_error()), req(FALSE))
}
