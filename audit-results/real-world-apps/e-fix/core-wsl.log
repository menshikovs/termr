⠹ |          3 | examples                                                       structure(list(c(2L, 5L), structure(c(1L, 1L), levels = c("East", "North", "West"), 
    class = "factor"), c(as.numeric("3.5"), as.numeric("2.75")), structure(c(as.numeric("20728"), 
    as.numeric("20731")), class = "Date")), names = c("id", "region", "score", "day"), 
    row.names = c(2L, 5L), class = "data.frame") 
local({
    .termr_data <- data
    .termr_rows <- seq_len(nrow(.termr_data))
    .termr_rows <- .termr_rows[!is.na(.termr_data[["region"]][.termr_rows]) & .termr_data[["region"]][.termr_rows] == 
        "East"]
    .termr_rows <- .termr_rows[order(.termr_data[["score"]][.termr_rows], decreasing = TRUE, 
        na.last = TRUE, method = "radix")]
    .termr_rows <- .termr_rows[c(1L, 2L)]
    .termr_data[.termr_rows, c("id", "region", "score", "day"), drop = FALSE]
}) 
local({
    .termr_data <- data
    .termr_data[["score"]][[2L]] <- as.numeric("3.75")
    .termr_data
}) 

