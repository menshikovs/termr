function (p, method, ...) 
{
    if (!is.proxy(p)) 
        stop("p must be a proxy object. See `help(plotlyProxy)`", 
            call. = FALSE)
    if (missing(method)) 
        stop("Must provide a plotly.js method (as a character string of length 1).\n", 
            sprintf("Valid options include: '%s'", paste(plotlyjs_methods(), 
                collapse = "', '")), call. = FALSE)
    method <- match.arg(method, plotlyjs_methods())
    msg <- list(id = p$id, method = method, args = list(...))
    if (isTRUE(p$deferUntilFlushed)) {
        p$session$onFlushed(function() {
            p$session$sendCustomMessage("plotly-calls", msg)
        }, once = TRUE)
    }
    else {
        p$session$sendCustomMessage("plotly-calls", msg)
    }
    p
}
